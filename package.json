{
  "name": "cmmf-creation-agent",
  "version": "0.1.0",
  "description": "CLI agent for generating and updating CMMF content models from natural language.",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.10.0"
  },
  "bin": {
    "cmmf-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage .tmp",
    "dev": "node --import tsx ./src/cli.ts",
    "generate": "node --import tsx ./src/cli.ts generate",
    "inspect": "node --import tsx ./src/cli.ts inspect",
    "validate": "node --import tsx ./src/cli.ts validate",
    "deps:verify": "node --import tsx ./scripts/verify-dependencies.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "check": "npm run build && npm run test && npm run deps:verify"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.63.0",
    "ajv": "^8.17.1",
    "openai": "^6.3.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
